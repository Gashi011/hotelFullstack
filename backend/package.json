},
"devDependencies": {
"@types/bcrypt": "^5.0.2",
"@types/cors": "^2.8.17",
"@types/express": "^4.17.21",
"@types/jsonwebtoken": "^9.0.6",
"@types/node": "^20.14.10",
"tsx": "^4.16.2",
"typescript": "^5.5.3"
},
"allowScripts": {
"esbuild@0.28.2": true,
"bcrypt@6.0.0": true
}
}